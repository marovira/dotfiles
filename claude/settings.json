{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
  },
  "permissions": {
    "allow": [
      "Read",
      "Write",
      "Edit",
      "Bash(cargo *)",
      "Bash(cat *)",
      "Bash(clang-format *)",
      "Bash(clang-tidy *)",
      "Bash(cmake --build *)",
      "Bash(cmake --preset *)",
      "Bash(cmake -E *)",
      "Bash(cmake -S * -B *)",
      "Bash(cpack *)",
      "Bash(ctest *)",
      "Bash(cut *)",
      "Bash(echo *)",
      "Bash(find *)",
      "Bash(git branch -c *)",
      "Bash(git branch)",
      "Bash(git checkout -- *)",
      "Bash(git diff *)",
      "Bash(git fetch *)",
      "Bash(git log *)",
      "Bash(git remote *)",
      "Bash(git rm *)",
      "Bash(git show *)",
      "Bash(git stash list)",
      "Bash(git stash pop *)",
      "Bash(git stash push *)",
      "Bash(git stash show *)",
      "Bash(git status)",
      "Bash(git switch *)",
      "Bash(git tag *)",
      "Bash(grep *)",
      "Bash(head *)",
      "Bash(ls *)",
      "Bash(make *)",
      "Bash(mkdir *)",
      "Bash(ninja *)",
      "Bash(printenv *)",
      "Bash(pwd)",
      "Bash(rmdir *)",
      "Bash(sort *)",
      "Bash(tail *)",
      "Bash(tree *)",
      "Bash(uniq *)",
      "Bash(uv *)",
      "Bash(wc *)",
      "Bash(which *)"
    ],
    "deny": [
      "Bash(git commit *)",
      "Bash(git merge *)",
      "Bash(git reset *)",
      "Bash(git rebase *)",
      "Bash(git clean *)",
      "Bash(git pull *)",
      "Bash(git push *)",
      "Bash(git branch -d *)",
      "Bash(git branch -D *)",
      "Bash(git stash drop *)",
      "Bash(git stash clear)",
      "Bash(rm *)",
      "Bash(chmod *)",
      "Bash(chown *)",
      "Bash(uvx *)",
      "Bash(cargo publish *)",
      "Bash(cargo install *)",
      "Bash(cargo uninstall *)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/precompact.sh"
          }
        ]
      }
    ]
  },
  "model": "opusplan",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": true
  },
  "awaySummaryEnabled": false,
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "theme": "dark-ansi"
}
